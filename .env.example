# deploy.sh creates random secrets. Never commit the real .env.
POSTGRES_PASSWORD=replace-with-random-secret
MINIO_ROOT_USER=youtube-storage
MINIO_ROOT_PASSWORD=replace-with-random-secret
S3_BUCKET=videos
# Blank validates the browser Origin against each request host.
# Set an explicit external HTTPS origin behind a reverse proxy.
PUBLIC_ORIGIN=
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=536870912
PORT=8080
BIND_ADDRESS=0.0.0.0
